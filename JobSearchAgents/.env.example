# --- Server ---
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:5173

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Encryption key (32 bytes hex) for the credential vault: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY=change-me-in-production
# Demo OAuth provider (built-in demo provider issues tokens without external accounts)
OAUTH_ENABLED=true

# --- Database ---
# SQLite is the default (zero-config). Set DATABASE_URL to a PostgreSQL DSN to use Postgres.
DATABASE_URL=sqlite://./data/jobsearch.db
DB_FILE=./data/jobsearch.db

# --- Playwright automation ---
HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SCRAPER_RETRIES=2
# When true, scrapers return realistic sample data instead of hitting live portals
SCRAPER_DEMO_MODE=true
# Browser automation (experimental). Auto-apply is disabled by default for safety.
AUTOMATION_ENABLED=false

# --- General-web job search (beyond the four portals) ---
# Engine used to discover job postings across the web: duckduckgo | bing | google
WEB_SEARCH_ENGINE=duckduckgo
# Max job results to collect per web search
WEB_SEARCH_MAX_RESULTS=8
# Follow each result page to extract detailed requirements (skills, salary, etc.)
WEB_SEARCH_FOLLOW_DETAIL=true

# --- External services (optional; app degrades gracefully when unset) ---
OPENAI_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=reports@jobsearch.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
